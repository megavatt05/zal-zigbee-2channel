menu "Конфигурация Батарейного Выключателя ESP32-C3"

    menu "Управление клавишами и линиями"

        config C3_LINE1_ENABLE
            bool "Включить клавишу Линии 1 (GPIO 2)"
            default y
            help
                Включает опрос и пробуждение контроллера по нажатию клавиши Линии 1 (GPIO 2).
                При нажатии на хаб передается команда переключения для Конечной Точки 1 (EP 1).
                Если выключатель используется как одноклавишный, отключение этой опции
                устраняет привязку пина и уменьшает размер кода.

        config C3_LINE2_ENABLE
            bool "Включить клавишу Линии 2 (GPIO 3)"
            default y
            help
                Включает опрос и пробуждение контроллера по нажатию клавиши Линии 2 (GPIO 3).
                При нажатии на хаб передается команда переключения для Конечной Точки 2 (EP 2).
                Если выключатель используется как одноклавишный, отключение этой опции
                устраняет привязку пина и уменьшает размер кода.

    endmenu

    menu "Настройки логирования и оптимизация веса"

        config C3_LOG_ENABLE
            bool "Включить информационное логирование (ESP_LOGI)"
            default y
            help
                Включает вывод информационных сообщений в порт UART.
                При отключении все информационные логи вырезаются из кода компилятором,
                что удаляет все текстовые строки из секции .rodata, значительно снижая вес
                прошивки и ускоряя пробуждение процессора из Deep Sleep.

    endmenu

endmenu
