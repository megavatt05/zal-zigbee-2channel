CONFIG_IDF_TARGET="esp32c6"

# Custom Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Zigbee Configuration: Coordinator (ZC)
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y
# CONFIG_ZB_ZED is not set

# Sleep disabled for Coordinator stability
# CONFIG_PM_ENABLE is not set
# CONFIG_FREERTOS_USE_TICKLESS_IDLE is not set
# CONFIG_IEEE802154_SLEEP_ENABLE is not set

CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_RTC_CLK_SRC_INT_RC=y

# Эндпоинты Zigbee
CONFIG_ZB_ENDPOINT_1_ENABLE=y
CONFIG_ZB_ENDPOINT_2_ENABLE=y
CONFIG_ZB_TUYA_UNCOUPLING_ENABLE=y

# Аппаратные модули
CONFIG_ESPNOW_BRIDGE_ENABLE=y
CONFIG_RGB_LED_ENABLE=y
CONFIG_SWITCH_DRIVER_ENABLE=y

# Логирование
# CONFIG_ZB_LOG_ENABLE is not set
